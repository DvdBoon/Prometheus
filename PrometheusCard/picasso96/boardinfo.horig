/************************************************************************/

struct CLUTEntry
{
	UBYTE	Red;
	UBYTE	Green;
	UBYTE	Blue;
};

struct ColorIndexMapping
{
	ULONG	ColorMask;
	ULONG	Colors[256];
};

/************************************************************************/

struct GfxMemChunk
{
	struct MinNode Node;
	char  *Ptr;
	ULONG  Size;
	BOOL   Used;
	struct GfxMemChunk *HashChain;
};

struct GfxMemHeader
{
	struct MinNode	Node; // initialized by driver
	APTR   Lower;        // initialized by driver
	APTR   Upper;        // initialized by driver
	// the following fields are maintained by rtg.libray
	// and should be zeroed after allocating this structure.
	ULONG  Reserved[3];
	struct MinList Chunks;
	ULONG  Free;
	struct GfxMemChunk *Largest;
};

/************************************************************************/

struct Template
{
	APTR   Memory;
	int16  BytesPerRow;
	uint8  XOffset;				// 0 <= XOffset <= 15
	uint8  DrawMode;
	uint32 FgPen;
	uint32 BgPen;
};

/************************************************************************/

struct Pattern
{
	APTR			Memory;
	UWORD			XOffset, YOffset;
	ULONG			FgPen, BgPen;
	UBYTE			Size;					// Width: 16, Height: (1<<pat_Size)
	UBYTE			DrawMode;
};

/************************************************************************/

struct Line
{
	int16			X, Y;
	uint16			Length;
	int16			dX, dY;
	int16			sDelta, lDelta, twoSDminusLD;
	uint16			LinePtrn;
	uint16			PatternShift;
	uint32			FgPen, BgPen;
	BOOL			Horizontal;
	uint8			DrawMode;
	int8			pad;
	uint16			Xorigin, Yorigin;
};

/************************************************************************/

struct BitMapExtra
{
	struct MinNode       BoardNode;
	struct BitMapExtra * HashChain;
	APTR                 Match;
	struct BitMap *      BitMap;
	struct BoardInfo *   BoardInfo;
	APTR                 MemChunk;
	struct RenderInfo    RenderInfo;
	uint16               Width;
	uint16               Height;
	uint16               Flags;
	struct Rectangle     Damage;
};

/* BitMapExtra flags */
#define	BMEF_ONBOARD      0x0001
#define	BMEF_SPECIAL      0x0002
#define BMEF_MODIFIED     0x0400
#define BMEF_VISIBLE      0x0800
#define BMEF_DISPLAYABLE  0x1000
#define	BMEF_SPRITESAVED  0x2000
#define	BMEF_CHECKSPRITE  0x4000
#define	BMEF_INUSE        0x8000

/************************************************************************/

struct SpecialFeature
{
	struct MinNode		 Node;
	struct BoardInfo	*BoardInfo;
	struct BitMap		*BitMap;
	ULONG					 Type;
	APTR					 FeatureData;
};

enum
{
	SFT_INVALID,
	SFT_FLICKERFIXER,
	SFT_VIDEOCAPTURE,
	SFT_VIDEOWINDOW,
	SFT_MEMORYWINDOW
};

