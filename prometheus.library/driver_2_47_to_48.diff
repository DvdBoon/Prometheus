+/* Mediator DevFunc: bits 0-2 function, 3-7 device (slot); the bus number */
+/* goes in bits 8-15 (0 for the slots on the Prometheus itself).          */
+
+static UWORD BoardDevFunc(PCIBoard *board)
+{
+    return (UWORD)(((PrmTag(board, PRM_BusNumber) & 0xFF) << 8) |
+                   ((PrmTag(board, PRM_SlotNumber) & 0x1F) << 3) |
+                    (PrmTag(board, PRM_FunctionNumber) & 0x07));
+}
+
+static PCIBoard *DevFuncBoard(UWORD devfunc)
+{
+    PCIBoard *board = NULL;
+
+    while (board = FindBoardTagList(myBase, board, NULL))
+    {
+        if (BoardDevFunc(board) == devfunc) return board;
+    }
+    return NULL;
+}
