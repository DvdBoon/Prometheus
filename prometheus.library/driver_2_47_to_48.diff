+/* --- bridge windows for ranges allocated after boot (4.8) ---------------- */
+
+static struct PCIBus *FindBus(struct PrometheusBase *pb, UBYTE busnr)
+{
+    struct PCIBus *pbus;
+
+    ForeachNode(&pb->pb_Busses, pbus)
+    {
+        if (pbus->br_BusNr == busnr) return pbus;
+    }
+    return NULL;
+}
+
+/* TRUE if bus busnr is bus rootnr or below it */
+
+static BOOL BusInSubtree(struct PrometheusBase *pb, UBYTE busnr, UBYTE rootnr)
+{
+    struct PCIBus *pbus;
+    WORD guard;
+
+    for (guard = 0; guard < 32; guard++)
+    {
+        if (busnr == rootnr) return TRUE;
+        if (busnr == 0) return FALSE;
+        if (!(pbus = FindBus(pb, busnr))) return FALSE;
+        busnr = pbus->br_pBusNr;
+    }
+    return FALSE;
+}
+
+/* The memory window of the bridge above bus pbus, as PCI addresses, */
+/* widened to include [lo, lo+size). 1 MB granularity.                */
+
+static void WidenedWindow(struct PCIBus *pbus, ULONG lo, ULONG size, ULONG *base, ULONG *limit)
+{
+    volatile struct PciConfig *br = pbus->br_ConfigBase;
+    ULONG wb = ((ULONG)(swapw(br->types.t1.pc_MemoryBase) & 0xFFF0)) << 16;
+    ULONG wl = (((ULONG)(swapw(br->types.t1.pc_MemoryLimit) & 0xFFF0)) << 16) | 0x000FFFFF;
+    ULONG nb = lo & 0xFFF00000;
+    ULONG nl = (lo + size - 1) | 0x000FFFFF;
+
+    if (wb <= wl)                                     /* window open: keep it */
+    {
+        if (wb < nb) nb = wb;
+        if (wl > nl) nl = wl;
+    }
+    *base = nb;
+    *limit = nl;
+}
+
+/* For a range [lo, lo+size) (PCI addresses) for a card on bus pbus: 0 if  */
+/* the bridge windows on the way can be widened to include it without      */
+/* covering anything outside their own subtree, else the PCI address just  */
+/* past the first range that is in the way.                                */
+
+static ULONG BridgePathConflict(struct PrometheusBase *pb, struct PCIBus *pbus, ULONG lo, ULONG size)
+{
+    struct PCIBus *other;
+    struct SpaceReq *srq;
+    ULONG nb, nl, start;
+    WORD guard;
+
+    for (guard = 0; (guard < 32) && pbus && (pbus->br_BusNr > 0) && pbus->br_ConfigBase; guard++)
+    {
+        WidenedWindow(pbus, lo, size, &nb, &nl);
+
+        ForeachNode(&pb->pb_Busses, other)
+        {
+            if (BusInSubtree(pb, other->br_BusNr, pbus->br_BusNr)) continue;
+
+            ForeachNode(&other->br_CardRequests, srq)
+            {
+                if ((srq->sr_Type == BLOCK_INOUT) || (!srq->sr_Tag->ti_Data)) continue;
+
+                start = srq->sr_Tag->ti_Data - (ULONG)pb->pb_BaseAddr;
+                if ((start <= nl) && (start + srq->sr_Size - 1 >= nb))
+                    return start + srq->sr_Size;
+            }
+        }
+        pbus = FindBus(pb, pbus->br_pBusNr);
+    }
+    return 0;
+}
+
+static void WidenBridgePath(struct PrometheusBase *pb, struct PCIBus *pbus, ULONG lo, ULONG size)
+{
+    struct Library *SysBase = pb->pb_SysBase;
+    volatile struct PciConfig *br;
+    ULONG nb, nl;
+    WORD guard;
+
+    for (guard = 0; (guard < 32) && pbus && (pbus->br_BusNr > 0) && pbus->br_ConfigBase; guard++)
+    {
+        br = pbus->br_ConfigBase;
+        WidenedWindow(pbus, lo, size, &nb, &nl);
+
+        /* the prefetchable window follows the memory window where it is  */
+        /* open (as AssignBusFS sets it); a closed one stays closed        */
+        if ((swapw(br->types.t1.pc_PrefetchMemBase) & 0xFFF0) <= (swapw(br->types.t1.pc_PrefetchMemLimit) & 0xFFF0))
+        {
+            br->types.t1.pc_PrefetchMemBase  = swapw((nb >> 16) & 0xFFF0);
+            br->types.t1.pc_PrefetchMemLimit = swapw((nl >> 16) & 0xFFF0);
+        }
+        br->types.t1.pc_MemoryBase  = swapw((nb >> 16) & 0xFFF0);
+        br->types.t1.pc_MemoryLimit = swapw((nl >> 16) & 0xFFF0);
+        CacheClearU();
+
+        D(kprintf("[AllocPCIAddressSpace] bus %ld window now 0x%08lx-0x%08lx\n", pbus->br_BusNr, nb, nl));
+        pbus = FindBus(pb, pbus->br_pBusNr);
+    }
+}
